[Tests]
  design = 'val-2l.md MatNeumannBC.md TrappingNodalKernel.md ReleasingNodalKernel.md'
  issues = '#405'
  validation = 'val-2l.md'
  [val-2l_csvdiff]
    type = CSVDiff
    input = 'val-2l.i'
    csvdiff = val-2l_out.csv
    requirement = 'The system shall be able to model deuterium transport through irradiated tungsten for comparison with experimental results.'
  []
  [val-2l_comparison]
    type = RunCommand
    command = 'python3 comparison_val-2l.py'
    requirement = 'The system shall be able to generate comparison plots between the analytical solution and simulated solution of validation case 2l'
    required_python_packages = 'matplotlib numpy pandas'
  []
  [val-2l_profile_animation]
    type = RunCommand
    command = 'python3 trapped_profile_animation.py'
    heavy = true
    prereq = val-2l_csvdiff
    requirement = 'The system shall be able to generate an animation of the mobile and trapped deuterium concentration profiles for a sinle trap during validation case 2l.'
    required_python_packages = 'matplotlib numpy pandas PIL'
  []
[]
